#!/usr/bin/env python3
"""
Git pre-commit guard: refuses a commit that would leak a secret, recorded data or a real family name.

Install once per clone (Mac and Pi):   git config core.hooksPath tools/hooks
Bypassing it (git commit --no-verify) is never OK in this repo.

Checks on what is being committed (staged files / added lines):
  1. file types that are data, not code: images (outside docs/images/), audio, video, embeddings, models, logs,
     CSV/JSONL, people stores, private/ - even when forced past .gitignore with `git add -f`
  2. secrets: API keys / tokens / private keys by pattern, plus `gitleaks` when it is installed
  3. the real household's names, read from private/household.json (so they are never written here); "Selim"
     (the author) is allowed
  4. files bigger than 5 MB (the CAD archive is the only big file and is not staged often)
"""
import json
import re
import shutil
import subprocess
import sys
import unicodedata
from pathlib import Path

ROOT = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip())
ALLOWED_NAMES = {"selim"}
MAX_BYTES = 5 * 1024 * 1024

DATA_PATH = re.compile(
    r"(^|/)(private|people[^/]*|collect|heard|barge|blackbox|data|recordings|scratch)/"
    r"|\.(wav|mp3|m4a|flac|ogg|raw|pcm|h264|mp4|mov|avi|npy|npz|pkl|pickle|pt|onnx|tflite|db|sqlite\d?|csv|jsonl|log"
    r"|env|pem|key|p12|heic|heif|webp|gif)$"
    r"|(^|/)(secrets\.env|household\.json|gcloud[^/]*\.json|[^/]*(service-account|credentials|token)[^/]*\.json)$",
    re.IGNORECASE)
IMAGE = re.compile(r"\.(jpe?g|png)$", re.IGNORECASE)
SECRET = re.compile(
    r"AIza[0-9A-Za-z_\-]{30,}|sk-ant-[A-Za-z0-9_\-]{10,}|sk-[A-Za-z0-9]{32,}|ghp_[A-Za-z0-9]{30,}|github_pat_\w{20,}"
    r"|xox[abposr]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|ya29\.[0-9A-Za-z_\-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----"
    r"|\"private_key\"\s*:\s*\"-----BEGIN"
    r"|(API_KEY|SECRET|TOKEN|PASSWORD)\s*=\s*['\"]?[A-Za-z0-9_\-]{16,}")


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, cwd=ROOT).stdout


def fold(s):
    """Lower case, Turkish letters to ASCII: 'Şükrü Işık' -> 'sukru isik'."""
    s = s.replace("İ", "i").replace("ı", "i").lower()
    return "".join(c for c in unicodedata.normalize("NFKD", s) if not unicodedata.combining(c))


def private_names():
    for p in (ROOT / "private" / "household.json", Path.home() / ".config" / "arcby" / "household.json"):
        try:
            return {fold(n) for n, _ in json.loads(p.read_text(encoding="utf-8"))} - ALLOWED_NAMES
        except (OSError, ValueError, TypeError):
            continue
    return set()


def main():
    problems = []
    files = [f for f in git("diff", "--cached", "--name-only", "--diff-filter=ACMR").splitlines() if f]
    for f in files:
        if DATA_PATH.search(f) or (IMAGE.search(f) and not f.startswith("docs/images/")):
            problems.append(f"data / secret file type: {f}")
        size = git("cat-file", "-s", f":{f}").strip()
        if size.isdigit() and int(size) > MAX_BYTES and not f.endswith(".f3d"):
            problems.append(f"file > 5 MB: {f} ({int(size) // 1024} KB)")
        if IMAGE.search(f) and f.startswith("docs/images/"):
            blob = subprocess.run(["git", "show", f":{f}"], capture_output=True, cwd=ROOT).stdout
            if b"Exif" in blob[:65536] or b"GPS" in blob[:65536]:
                problems.append(f"photo still has EXIF metadata (run tools/clean_photos.py): {f}")

    names = private_names()
    name_re = re.compile(r"(?<![a-z])(" + "|".join(map(re.escape, sorted(names))) + r")(?![a-z])") if names else None
    current = None
    for line in git("diff", "--cached", "-U0", "--no-color", "--diff-filter=ACMR").splitlines():
        if line.startswith("+++ "):
            current = line[6:] if line.startswith("+++ b/") else line[4:]
            continue
        if not line.startswith("+") or line.startswith("+++"):
            continue
        text = line[1:]
        if SECRET.search(text):
            problems.append(f"looks like a secret in {current}: {text.strip()[:60]}...")
        if name_re and (m := name_re.search(fold(text))):
            problems.append(f"real household name '{m.group(1)}' in {current}: {text.strip()[:80]}")

    if shutil.which("gitleaks"):
        r = subprocess.run(["gitleaks", "git", "--staged", "--no-banner", "--redact", "-v", "."],
                           capture_output=True, text=True, cwd=ROOT)
        if r.returncode not in (0,):
            problems.append("gitleaks found a leak:\n" + (r.stdout + r.stderr).strip()[-1500:])
    else:
        print("pre-commit: gitleaks not installed - pattern checks only (brew install gitleaks)", file=sys.stderr)

    if problems:
        print("\nCOMMIT REFUSED - this would leak private data:\n  - " + "\n  - ".join(problems)
              + "\n\nUnstage it (git restore --staged <file>) or fix it. Never use --no-verify here.\n", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
