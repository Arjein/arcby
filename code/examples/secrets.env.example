# Copy to ~/.config/arcby/secrets.env on the robot and fill in your own keys:
#   mkdir -p ~/.config/arcby && cp code/examples/secrets.env.example ~/.config/arcby/secrets.env
#   chmod 600 ~/.config/arcby/secrets.env
# This file is read by robot/tts.py, robot/stt.py and robot/mind.py. NEVER commit the real one.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
